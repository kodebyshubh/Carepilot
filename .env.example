# Copy to .env and fill. Never commit .env.
# LLM provider: auto | groq | ollama | extractive
LLM_PROVIDER=auto
# One key, or several comma-separated: on a rate limit (429) or rejected key the next one is used.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Hugging Face write token, only needed to deploy the Space
HF_TOKEN=
